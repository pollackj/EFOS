# EFOS runtime configuration.
# Copy this file to .env and fill in the values. Never commit .env.

# Required: the PostgreSQL application role password.
EFOS_DB_PASSWORD=your-postgres-password

# Optional DeepSeek assistant key.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Google Calendar read-only OAuth 2.0 (no API keys).
# Create a Desktop OAuth client in Google Cloud Console and enable the
# Google Calendar API. Tokens are written to the Windows Credential Manager,
# never to .env, PostgreSQL, or logs.
EFOS_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
EFOS_GOOGLE_CLIENT_SECRET=your-client-secret
EFOS_GOOGLE_CALENDAR_ID=primary

# Optional connection overrides. Defaults are localhost:5432/postgres/efos.
# EFOS_DB_HOST=localhost
# EFOS_DB_PORT=5432
# EFOS_DB_USER=efos_app
# EFOS_DB_NAME=efos

# Optional one-time administrative credentials for first-launch provisioning.
# The setup wizard prompts for these if the database does not exist. They are
# never persisted.
# EFOS_ADMIN_USER=postgres
# EFOS_ADMIN_PASSWORD=...

# Optional model overrides.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
